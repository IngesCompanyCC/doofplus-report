---
title: "Database Diagram – Quality & Compliance Bounded Context (MySQL 8)"
---
erDiagram
  direction LR
  quality_documents {
    int id PK
    varchar(30) code "UK with version"
    varchar(10) version "2.4"
    varchar(255) title
    varchar(24) status "Draft, InReview, Approved, Obsolete"
    varchar(100) author "user full name"
    varchar(100) technical_reviewer "user full name"
    varchar(100) approver "user full name"
    date changed_at "nullable"
    text purpose
    text scope
    text procedure_text "procedure is reserved in MySQL"
    text revision_summary
    int review_cycle_months "12, 24"
  }
  analytical_results {
    int id PK
    varchar(30) batch_code "ref manufacturing.production_batches"
    varchar(30) sample_code
    varchar(30) report_code
    varchar(100) test_name
    varchar(50) protocol
    varchar(30) result "98.7 %"
    varchar(50) specification "95.0–105.0 %"
    varchar(100) analyst "user full name"
    varchar(24) status "Within, Oos, Pending"
    varchar(24) approval "Requested, Approved"
  }
  batch_releases {
    int id PK
    varchar(30) batch_code "ref manufacturing.production_batches"
    int batch_id "ref manufacturing.production_batches"
    varchar(100) requested_by "user full name"
    varchar(24) status "Pending, Released, Rejected"
    varchar(500) decision
    varchar(100) signature_reference "electronic signature"
    datetime signed_at "nullable"
    varchar(100) signed_by "user full name"
  }
  evidences {
    int id PK
    varchar(60) record_code "DEV-26017, B-26041"
    varchar(255) file_name
    varchar(255) detail
    varchar(24) status "Attached, PendingReview, Reviewed"
  }
  deviations {
    int id PK
    varchar(30) code UK "DEV-26017"
    varchar(255) title
    varchar(30) batch_code "ref manufacturing.production_batches"
    varchar(30) order_code "ref manufacturing.production_orders"
    text summary
    varchar(24) classification "Minor, Major, Critical"
    text containment
    int severity "1-5"
    int likelihood "1-5"
    int detectability "1-5"
    varchar(24) status "Open, Submitted, Dispositioned, Closed"
    varchar(150) root_cause
    varchar(100) reported_by "user full name"
    datetime reported_at "nullable"
    varchar(100) owner "user full name"
    datetime due_at "nullable"
    varchar(30) capa_code "code of capa_plans"
  }
  capa_plans {
    int id PK
    varchar(30) code UK "CAPA-26009"
    varchar(30) source_deviation "code of deviations"
    varchar(255) title
    varchar(100) owner "user full name"
    varchar(100) reviewer "user full name"
    varchar(150) root_cause
    varchar(500) acceptance_criterion
    date effectiveness_check_at "nullable"
    varchar(24) status "Draft, InProgress, InApproval, Closed"
  }
  capa_actions {
    int id PK
    varchar(30) capa_code "code of capa_plans"
    varchar(10) code "CA-01, PA-01"
    varchar(24) type "Corrective, Preventive"
    varchar(255) title
    varchar(100) owner "user full name"
    date due_at "nullable"
    varchar(24) status "Open, Planned, InReview, Complete"
    varchar(150) evidence
    tinyint(1) evidence_attached
  }
  audits {
    int id PK
    varchar(30) code UK "AUD-26004"
    varchar(255) title
    varchar(40) period
    int areas_reviewed
    int areas_total
    varchar(24) status "Scheduled, InProgress, Closed"
  }
  audit_findings {
    int id PK
    varchar(30) audit_code "code of audits"
    varchar(10) code "F-01"
    varchar(255) title
    varchar(24) classification "Minor, Major, Critical"
    varchar(100) owner "user full name"
    date due_at "nullable"
    varchar(24) status "EvidencePending, InReview, Closed"
    text observation
    text response
    text closure_requirement
  }
  audit_events {
    int id PK
    varchar(30) event_code "EVT-89416"
    datetime occurred_at "nullable"
    varchar(100) actor "user full name"
    varchar(40) actor_role
    varchar(100) event
    varchar(60) record_code
    varchar(40) result "free text: Success, Alert created, Approved…"
    varchar(100) field
    varchar(255) before_value
    varchar(255) after_value
    varchar(255) reason
  }
  regulatory_reports {
    int id PK
    varchar(30) code UK "RPT-26012"
    varchar(24) type "BatchDossier, QualityReview, CapaSummary, AuditEvidence"
    varchar(100) scope
    varchar(100) owner "user full name"
    varchar(24) status "Draft, Blocked, Approved"
    varchar(100) template
    varchar(100) format
    date created_on "date of the report, nullable"
  }
  collaboration_tasks {
    int id PK
    varchar(255) title
    varchar(60) record_code
    varchar(255) detail
    varchar(100) owner "user full name"
    datetime due_at "nullable"
    varchar(24) status "ToDo, Open, Pending, InReview, Ready, Done"
  }
  task_comments {
    int id PK
    varchar(60) record_code
    varchar(100) author "user full name"
    datetime posted_at "nullable"
    text text
    varchar(5) initials "MM"
  }
  traceability_gaps {
    int id PK
    varchar(30) batch_code "ref manufacturing.production_batches"
    varchar(150) missing_record
    varchar(500) detail
    varchar(24) status "Open, UnderReview, Resolved"
    varchar(100) product "product name"
  }
  deviations ||--o| capa_plans : "source_deviation = code"
  capa_plans ||--|{ capa_actions : "capa_code = code"
  audits ||--o{ audit_findings : "audit_code = code"
