---
title: "Database Diagram – IoT Monitoring Bounded Context (MySQL 8)"
---
erDiagram
  equipment {
    bigint id PK
    varchar(30) code UK "EQ-MIX-02"
    varchar(150) name
    varchar(150) model "brand, model and serial"
    varchar(100) location "Ate · Line 02"
    varchar(10) calibration_status "Fit, Due, NotFit"
    date calibration_due
    varchar(50) certificate "CAL-MIX-0326"
    date next_maintenance
    varchar(150) maintenance_owner
    varchar(30) work_order "nullable"
    varchar(255) health_note
  }
  calibration_records {
    bigint id PK
    bigint equipment_id FK
    date calibrated_at
    date valid_until
    varchar(50) certificate
  }
  maintenance_records {
    bigint id PK
    bigint equipment_id FK
    date performed_at
    varchar(30) work_order
    varchar(150) owner
    date next_due_date
  }
  sensors {
    bigint id PK
    varchar(30) code UK "T-204"
    varchar(128) device_id UK "ThingsBoard"
    varchar(20) type "Temperature, Humidity, Pressure"
    varchar(10) unit "°C, %RH, Pa"
    varchar(30) equipment_code FK
    decimal lower_limit "(12,4)"
    decimal upper_limit "(12,4)"
    varchar(10) status "Active, Offline"
    varchar(30) assigned_batch "ref manufacturing.production_batches"
  }
  readings {
    bigint id PK
    varchar(30) sensor_code FK
    varchar(30) batch_code "ref manufacturing.production_batches"
    decimal value "(12,4)"
    datetime recorded_at "indexed"
    varchar(30) source "ThingsBoard"
  }
  alerts {
    bigint id PK
    varchar(30) code UK "ALT-26031"
    varchar(30) sensor_code FK
    varchar(30) equipment_code FK
    varchar(30) batch_code "ref manufacturing.production_batches"
    varchar(10) severity "Warning, Critical"
    varchar(25) status "Open, Acknowledged, UnderInvestigation, Closed"
    varchar(150) title
    varchar(500) detail
    varchar(150) acknowledged_by "nullable"
    datetime acknowledged_at "nullable"
    varchar(500) response_note "nullable"
    varchar(30) linked_record "DEV-26017, nullable"
  }
  equipment ||--o{ calibration_records : "calibrated"
  equipment ||--o{ maintenance_records : "maintained"
  equipment ||--o{ sensors : "monitored by"
  sensors ||--o{ readings : "emits"
  sensors ||--o{ alerts : "raises"
  equipment ||--o{ alerts : "affected by"
