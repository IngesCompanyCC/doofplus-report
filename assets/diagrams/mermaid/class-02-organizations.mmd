---
title: "Class Diagram – Organizations & Profiles Bounded Context"
---
classDiagram
  direction LR
  class Organization {
    <<Aggregate Root>>
    +long Id
    +string LegalName
    +Ruc Ruc
    +string Region
    +string OwnerName
    +OrganizationStatus Status
    +ICollection~Facility~ Facilities
    +Organization(RegisterOrganizationCommand command)
    +AddFacility(string name, FacilityType type, string timezone) Facility
    +Verify() void
    +Deactivate() void
  }
  class Facility {
    <<Entity>>
    +long Id
    +string Name
    +FacilityType Type
    +string Timezone
    +string OwnerName
    +FacilityStatus Status
  }
  class Ruc {
    <<Value Object>>
    +string Value
    +Ruc(string value)
  }
  class Profile {
    <<Aggregate Root>>
    +long Id
    +long UserId
    +long OrganizationId
    +PersonName Name
    +string Email
    +Area Area
    +string Site
    +string Language
    +NotificationPreferences Preferences
    +UpdatePreferences(NotificationPreferences preferences) void
    +ChangeLanguage(string language) void
  }
  class PersonName {
    <<Value Object>>
    +string FirstName
    +string LastName
    +GetFullName() string
  }
  class NotificationPreferences {
    <<Value Object>>
    +bool EmailEnabled
    +bool InAppEnabled
  }
  class AdministrativeActivity {
    <<Aggregate Root>>
    +long Id
    +long OrganizationId
    +string Title
    +string Actor
    +DateTime OccurredAt
  }
  class ContactInquiry {
    <<Aggregate Root>>
    +long Id
    +string FullName
    +string Email
    +string Message
    +InquiryStatus Status
    +DateTime ReceivedAt
    +ContactInquiry(SendContactInquiryCommand command)
    +MarkAsAnswered() void
  }
  class OrganizationStatus {
    <<enumeration>>
    Active
    Pending
    PendingVerification
    Inactive
  }
  class FacilityType {
    <<enumeration>>
    Manufacturing
    QcLaboratory
  }
  class FacilityStatus {
    <<enumeration>>
    Active
    Inactive
  }
  class Area {
    <<enumeration>>
    Quality
    Production
    Administration
  }
  class InquiryStatus {
    <<enumeration>>
    Received
    Answered
  }
  class IOrganizationRepository {
    <<interface>>
    +ExistsByRuc(Ruc ruc) bool
  }
  class IProfileRepository {
    <<interface>>
    +FindByUserIdAsync(long userId) Task~Profile?~
  }
  class IOrganizationCommandService {
    <<interface>>
    +Handle(RegisterOrganizationCommand command) Task~Result~Organization~~
    +Handle(AddFacilityCommand command) Task~Result~Facility~~
  }
  class IProfileCommandService {
    <<interface>>
    +Handle(UpdateProfilePreferencesCommand command) Task~Result~Profile~~
  }
  class IContactInquiryCommandService {
    <<interface>>
    +Handle(SendContactInquiryCommand command) Task~Result~ContactInquiry~~
  }
  class ExternalIamService {
    +CreateAdministrator(long organizationId, string fullName, string email, string password) long?
  }
  Organization "1" *-- "1..*" Facility : operates
  Organization *-- Ruc : ruc
  Organization --> OrganizationStatus : status
  Facility --> FacilityType : type
  Facility --> FacilityStatus : status
  Profile "0..*" --> "1" Organization : belongsTo
  Profile *-- PersonName : name
  Profile *-- NotificationPreferences : preferences
  Profile --> Area : area
  AdministrativeActivity "0..*" --> "1" Organization : loggedFor
  ContactInquiry --> InquiryStatus : status
  IOrganizationRepository ..> Organization : persists
  IProfileRepository ..> Profile : persists
  IOrganizationCommandService ..> ExternalIamService : uses
  IProfileCommandService ..> IProfileRepository : uses
